# Copie este arquivo para ".env" (na mesma pasta) e preencha com os valores
# do seu projeto em supabase.com -> Project Settings -> API.
# O arquivo ".env" nunca deve ser commitado (já está no .gitignore).

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-public-key-aqui

# ─── Depósito real via PIX (Mercado Pago) ──────────────────────────────────
# Estas 4 variáveis são usadas SÓ pelas Vercel Functions (api/create-pix.js
# e api/webhook.js), nunca pelo front. NÃO leve o prefixo VITE_ nelas —
# se levasse, o Vite embutiria o valor no bundle público do navegador.
# Configure os valores reais direto no painel da Vercel (Project Settings ->
# Environment Variables), não neste arquivo.

# Service role key do Supabase (Project Settings -> API -> service_role).
# Tem acesso total ao banco, ignorando RLS — trate como senha de root.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# Access token de produção do Mercado Pago (Suas integrações -> Credenciais).
MP_ACCESS_TOKEN=seu-access-token-de-producao-aqui

# Secret do webhook, gerado no painel do Mercado Pago ao cadastrar a URL
# https://SEU-DOMINIO/api/webhook em Suas integrações -> Webhooks.
MP_WEBHOOK_SECRET=seu-webhook-secret-aqui

# URL pública do site em produção (usada pra montar a notification_url do MP).
PUBLIC_APP_URL=https://plataformanova-one.vercel.app
