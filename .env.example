# Copie este arquivo para ".env" (na mesma pasta) e preencha com os valores
# do seu projeto em supabase.com -> Project Settings -> API.
# O arquivo ".env" nunca deve ser commitado (já está no .gitignore).

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-public-key-aqui
